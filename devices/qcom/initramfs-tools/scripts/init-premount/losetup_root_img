#!/bin/sh

# Runs during init-premount: loop-mounts a rootfs image stored on a partition.
# Kernel cmdline: rootimg=<PARTSPEC>/<path/to/image>
# Example:        rootimg=PARTLABEL=userdata/media/0/rootfs.img

set -e

prereqs() { echo ""; }

case "${1}" in
    prereqs) prereqs; exit 0 ;;
esac

# Fallback logging (overridden by /scripts/functions if present)
log_warning_msg() { echo "W: losetup-rootimg: $*" >&2; }
log_success_msg()  { echo "I: losetup-rootimg: $*"; }
[ -r /scripts/functions ] && . /scripts/functions

# Parse rootimg=PARTSPEC/path/to/image from kernel cmdline
IMGPART=""
IMGRELPATH=""
for x in $(cat /proc/cmdline); do
    case "${x}" in
        rootimg=*)
            ROOTIMG="${x#rootimg=}"
            IMGPART="${ROOTIMG%%/*}"
            IMGRELPATH="${ROOTIMG#*/}"
            ;;
    esac
done

if [ -z "${IMGPART}" ] || [ -z "${IMGRELPATH}" ]; then
    exit 0
fi

# Resolve block device by raw name or blkid tag (PARTLABEL=, UUID=, LABEL=)
if [ -b "/dev/${IMGPART}" ]; then
    DEVICE="/dev/${IMGPART}"
elif DEVICE="$(blkid -l -t "${IMGPART}" -o device 2>/dev/null)" && [ -b "${DEVICE}" ]; then
    : # DEVICE assigned above
else
    log_warning_msg "cannot resolve device for '${IMGPART}'"
    exit 1
fi

# Mount partition read-only, then attach the image as a loop device
MNTDIR="/run/rootimg-mnt"
mkdir -p "${MNTDIR}"
FSTYPE="$(blkid "${DEVICE}" -o value -s TYPE)"
mount -r -t "${FSTYPE}" "${DEVICE}" "${MNTDIR}"

IMGPATH="${MNTDIR}/${IMGRELPATH}"

if [ ! -f "${IMGPATH}" ]; then
    log_warning_msg "image not found: ${IMGPATH}"
    umount "${MNTDIR}"
    rmdir "${MNTDIR}"
    exit 1
fi

LOOP="$(losetup --find --show "${IMGPATH}")"
log_success_msg "${IMGPATH} → ${LOOP}"
